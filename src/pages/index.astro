---
// src/pages/index.astro
import machines from '../data/machines.json';

// AKILLI VERİ DÖNÜŞTÜRÜCÜ: Veri hangi formatta gelirse gelsin 'standard' bir yapıya sokar
const displayMachines = machines.map(m => {
    // 1. Durum: Siyah kutudaki düz yapı (model, tanitim, gercek_resim)
    if (m.model) {
        return {
            isim: m.model,
            aciklama: m.tanitim || "",
            resim: m.gercek_resim || "https://via.placeholder.com/500x290",
            slug: m.slug || m.model.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
            dil: m.dil || "tr"
        };
    }
    // 2. Durum: Diğer nested yapı (diller.tr.isim)
    if (m.diller?.tr) {
        return {
            isim: m.diller.tr.isim,
            aciklama: m.diller.tr.aciklama || "",
            resim: m.diller.tr.resimler?.[0] || "https://via.placeholder.com/500x290",
            slug: m.slug,
            dil: "tr"
        };
    }
    return null;
}).filter(m => m !== null);
---

<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Jaguar Ltd | Makine Envanteri</title>
		<style>
			body { font-family: 'Segoe UI', system-ui, sans-serif; background: #0f172a; color: #f1f5f9; padding: 2rem; margin: 0; }
			h1 { color: #38bdf8; text-align: center; border-bottom: 2px solid #1e293b; padding-bottom: 1rem; }
			.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
			.card { background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 1rem; transition: 0.3s; display: flex; flex-direction: column; }
			.card:hover { transform: translateY(-5px); border-color: #38bdf8; box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.5); }
			.card img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; background: #000; }
			.card h3 { margin: 15px 0 5px 0; font-size: 1.1rem; color: #f8fafc; height: 3rem; overflow: hidden; }
			.card p { font-size: 0.85rem; color: #94a3b8; line-height: 1.5; height: 4.5rem; overflow: hidden; margin-bottom: 1rem; }
			.badge { background: #0369a1; color: #bae6fd; padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: bold; width: fit-content; text-transform: uppercase; }
		</style>
	</head>
	<body>
		<h1>🏗️ JAGUAR LTD GLOBAL MAKİNE HATTI</h1>
		<p style="text-align: center; color: #94a3b8;">Sistem Aktif: {displayMachines.length} Makine Yayında.</p>
		
		<div class="grid">
			{displayMachines.map((m) => (
				<div class="card">
					<img src={m.resim} alt={m.isim} />
					<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
						<div class="badge">{m.dil}</div>
						<span style="font-size: 0.7rem; color: #475569;">{m.slug.substring(0, 20)}</span>
					</div>
					<h3>{m.isim}</h3>
					<p>{m.aciklama}</p>
					<a href={`/${m.slug}`} style="background: #38bdf8; color: #0f172a; border: none; padding: 0.6rem; border-radius: 8px; cursor: pointer; font-weight: bold; margin-top: auto; text-align: center; text-decoration: none; display: block;">9 Dilde İncele</a>
				</div>
			))}
		</div>
	</body>
</html>