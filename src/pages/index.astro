---
// src/pages/index.astro - ADIM 1: Kusursuz Liste ve Resimler
import Header from '../components/Header.astro';
import machinesData from '../data/machines.json';

const allMachines = Array.isArray(machinesData) ? machinesData : (machinesData.machines || []);
---

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jaguar / Yılmaz Makine Global</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #0a0a0a; color: #eee; margin: 0; }
        .container { max-width: 1300px; margin: 2rem auto; padding: 0 20px; }
        .machine-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 25px; }
        .machine-card { background: #151515; border: 1px solid #333; border-radius: 15px; overflow: hidden; text-decoration: none; color: inherit; transition: 0.3s; display: flex; flex-direction: column; }
        .machine-card:hover { border-color: #ffcc00; transform: translateY(-5px); }
        .machine-card img { width: 100%; height: 220px; object-fit: cover; border-bottom: 3px solid #ffcc00; }
        .card-content { padding: 1.5rem; flex-grow: 1;}
        .card-content h3 { margin: 0 0 10px 0; color: #ffcc00; font-size: 1.2rem; }
        .card-content p { font-size: 0.9rem; color: #bbb; line-height: 1.4; margin: 0; }
        #noResults { display: none; text-align: center; padding: 3rem; color: #ffcc00; font-size: 1.2rem; }
    </style>
</head>
<body>
    <Header />
    <main class="container">
        <h1 style="border-left: 6px solid #ffcc00; padding-left: 20px; margin-bottom: 2rem;">
            Makine Envanteri
        </h1>
        <div id="noResults">Aranan kriterde makine bulunamadı.</div>
        
        <div class="machine-grid" id="machineGrid">
            {allMachines.map((m) => {
                // VERİ YOLLARI TAM İSABET AYARLANDI
                const tr = m.diller?.tr || {};
                const title = tr.isim || m.slug.toUpperCase() || "İsimsiz Makine";
                const desc = tr.aciklama || "";
                
                return (
                    <a href={`/machines/${m.slug}`} class="machine-card" data-search={title.toLowerCase()}>
                        {/* RESİM YOLU DÜZELTİLDİ: Doğrudan /images/ klasörüne bakıyor */}
                        <img 
                            src={`/images/${m.slug}.webp`} 
                            alt={title} 
                            onerror="this.onerror=null; this.src='/images/no-image.webp';" 
                        />
                        <div class="card-content">
                            <h3>{title}</h3>
                            <p>{desc.length > 100 ? desc.substring(0, 100) + "..." : desc}</p>
                        </div>
                    </a>
                );
            })}
        </div>
    </main>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const search = document.getElementById('globalSearch');
            const cards = document.querySelectorAll('.machine-card');
            const noRes = document.getElementById('noResults');
            
            if (search) {
                search.addEventListener('input', (e) => {
                    const term = e.target.value.toLowerCase().trim();
                    let count = 0;
                    cards.forEach(c => {
                        const t = c.getAttribute('data-search') || "";
                        const visible = t.includes(term);
                        c.style.display = visible ? 'flex' : 'none';
                        if (visible) count++;
                    });
                    noRes.style.display = (count === 0 && term !== "") ? 'block' : 'none';
                });
            }
        });
    </script>
</body>
</html>