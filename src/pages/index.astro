---
// 1. Kusursuz veriyi çekiyoruz
import makineler from '../data/makine_verileri_kusursuz.json';

const sayfaBasligi = "Jaguar Ltd - Ürün Kataloğu";
---

<html lang="bg">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{sayfaBasligi}</title>
		<style>
			/* Genel Stil */
			body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #f0f2f5; margin: 0; padding: 40px 20px; }
			h1 { text-align: center; color: #1a1a1a; margin-bottom: 40px; font-size: 2.5rem; }
			
			/* Grid Yapısı */
			.grid { 
				display: grid; 
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); 
				gap: 25px; 
				max-width: 1300px; 
				margin: 0 auto; 
			}
			
			/* Kart Tasarımı */
			.card { 
				background: white; 
				border-radius: 12px; 
				overflow: hidden;
				box-shadow: 0 10px 20px rgba(0,0,0,0.05);
				transition: transform 0.3s ease;
				display: flex;
				flex-direction: column;
				border: 1px solid #e1e4e8;
			}
			.card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.1); }
			
			/* Resim Kutusu - HTML ile eşleşmesi için burası kritik */
			.img-container {
				width: 100%;
				height: 250px;
				background: #fff;
				display: flex;
				align-items: center;
				justify-content: center;
				border-bottom: 1px solid #f0f0f0;
				position: relative;
				padding: 15px;
				box-sizing: border-box;
			}
			.img-container img { 
				max-width: 100%; 
				max-height: 100%; 
				object-fit: contain;
			}
			
			/* Dil Etiketi */
			.badge { 
				position: absolute;
				top: 15px;
				right: 15px;
				background: #e74c3c; 
				color: white; 
				padding: 4px 12px; 
				border-radius: 20px; 
				font-size: 0.7rem; 
				font-weight: bold;
				z-index: 2;
			}

			/* İçerik Alanı */
			.content { padding: 20px; flex-grow: 1; display: flex; flex-direction: column; }
			.card h2 { font-size: 1.15rem; margin: 0 0 12px 0; color: #2c3e50; line-height: 1.3; min-height: 2.6rem; display: flex; align-items: center; }
			.card p { font-size: 0.85rem; color: #666; line-height: 1.5; margin-bottom: 20px; height: 4.5em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
			
			/* Alt Kısım */
			.footer-link {
				margin-top: auto;
				padding-top: 15px;
				border-top: 1px dashed #eee;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}
			.btn { font-size: 0.8rem; color: #3498db; text-decoration: none; font-weight: 600; text-transform: uppercase; }
			.btn:hover { color: #2980b9; }
		</style>
	</head>
	<body>
		<h1>{sayfaBasligi} ({makineler.length})</h1>
		
		<div class="grid">
			{makineler.map((makine) => (
				<div class="card">
					<div class="img-container">
						<span class="badge">{makine.dil.toUpperCase()}</span>
						<img 
							src={makine.gercek_resim} 
							alt={makine.model} 
							loading="lazy" 
							onerror="this.style.opacity='0.3'; this.src='https://via.placeholder.com/300x200?text=Image+Not+Found';"
						/>
					</div>
					<div class="content">
						<h2>{makine.model}</h2>
						<p>{makine.tanitim || "Индустриално решение за обработка на PVC и алуминиеви профили."}</p>
						<div class="footer-link">
							<a href={makine.eski_link} target="_blank" class="btn">Детайли →</a>
						</div>
					</div>
				</div>
			))}
		</div>
	</body>
</html>