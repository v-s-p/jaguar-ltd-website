---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import machines from '../data/machines.json'; // Orijinal JSON verisini okumaya devam ediyoruz
---

<BaseLayout title="Makine Envanteri | Jaguar LTD">
  <section class="container mx-auto px-4 py-12 max-w-7xl">
    
    <div class="mb-12 border-b-4 border-brand-dark inline-block pb-2">
      <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">Global Envanter</h1>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pb-16">
      {machines && machines.map((m: any) => {
        const tr = m.diller?.tr || {};
        const makineIsmi = tr.isim || m.slug?.toUpperCase() || "BİLİNMEYEN MAKİNE";
        const resimYolu = (tr.resimler && tr.resimler.length > 0) ? tr.resimler[0] : '/placeholder.png';
        const aciklama = tr.aciklama || '';

        return (
          <a href={`/machines/${m.slug}`} class="block group h-full cursor-pointer">
            <div class="bg-brand-gray border border-gray-200 rounded-xl shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col h-full overflow-hidden transform group-hover:-translate-y-2">
              
              <div class="h-64 p-10 flex items-center justify-center bg-white relative">
                <img src={resimYolu} alt={makineIsmi} class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-110" onerror="this.onerror=null; this.src='/placeholder.png';" />
              </div>
              
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-xl text-brand-light font-extrabold mb-3 leading-snug">{makineIsmi}</h3>
                <p class="text-sm text-gray-600 line-clamp-3 mb-6 leading-relaxed">{aciklama}</p>
                
                <div class="mt-auto flex justify-end items-center text-sm font-extrabold text-brand-light tracking-wide">
                  DETAYLI BİLGİ <span class="ml-2 text-xl font-normal transition-transform duration-200 group-hover:translate-x-1 group-hover:text-brand-accent">〉</span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>