---
import BaseLayout from '../../layouts/BaseLayout.astro';
import machines from '../../data/machines.json';

// 1. Hangi kategori URL'lerinin üretileceğini belirliyoruz
export async function getStaticPaths() {
  return [
    { params: { kategori: 'pvc' }, props: { catName: 'PVC' } },
    { params: { kategori: 'aluminyum' }, props: { catName: 'Alüminyum' } }
  ];
}

const { catName } = Astro.props;

// 2. Sizin Belirlediğiniz Sabit ve Profesyonel Alt Kategoriler
const subcategoryMap: Record<string, string[]> = {
  "Alüminyum": [
    "İŞLEME MERKEZLERİ", "KESİM", "FREZE", "KÖŞE PRES", "KERTME", "PRES",
    "TAŞIMA", "AKTARMA", "TALAŞ TOPLAMA", "MONTAJ"
  ],
  "PVC": [
    "İŞLEME MERKEZİ", "ÇAPAK ALMA", "KESİM", "FREZE", "KERTME", "VİDALAMA",
    "KAYNAK", "TAŞIMA", "TALAŞ TOPLAMA", "AKTARMA", "MONTAJ"
  ]
};
const allowedSubcats = subcategoryMap[catName] || [];

// 3. FIX: kategoriler ve alt_kategoriler üst seviyede, diller.tr altında değil!
const filteredMachines = machines.filter((m: any) => {
  const kats = m.kategoriler || [];
  return kats.some((k: string) => k.toUpperCase().includes(catName.toUpperCase()) || catName.toUpperCase().includes(k.toUpperCase()));
}).map((m: any) => {
  const subcats = m.alt_kategoriler || [];
  return { ...m, finalSubcats: subcats.join("||") };
});
---

<BaseLayout title={`${catName} İşleme Makineleri | Jaguar LTD`}>
  <section class="container mx-auto px-4 py-12 max-w-7xl">
    
    <div class="mb-12 border-b-4 border-brand-dark inline-block pb-2">
      <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">{catName} İşleme Makineleri</h1>
    </div>

    <!-- Filtreleme Butonları -->
    <div class="flex flex-wrap gap-3 mb-10" id="filter-container">
      <button class="filter-btn active bg-brand-accent text-brand-dark font-extrabold px-6 py-2 rounded-full shadow-sm hover:shadow-md transition-all" data-filter="all">TÜM {catName.toUpperCase()} MAKİNELERİ</button>
      {allowedSubcats.map((sub: string) => (
        <button class="filter-btn bg-white text-gray-600 border border-gray-200 hover:border-brand-accent hover:text-brand-dark font-bold px-5 py-2 rounded-full shadow-sm hover:shadow-md transition-all" data-filter={sub}>{sub}</button>
      ))}
    </div>
    
    {filteredMachines.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pb-16" id="machines-grid">
        {filteredMachines.map((m: any) => {
          const tr = m.diller?.tr || {};
          const makineIsmi = tr.isim || m.slug?.toUpperCase() || "BİLİNMEYEN MAKİNE";
          const resimYolu = (tr.resimler && tr.resimler.length > 0) ? tr.resimler[0] : '/placeholder.png';
          const aciklama = tr.aciklama || '';

          return (
            <a href={`/machines/${m.slug}`} class="machine-card block group h-full cursor-pointer" data-subcategories={m.finalSubcats}>
              <div class="bg-brand-gray border border-gray-200 rounded-xl shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col h-full overflow-hidden transform group-hover:-translate-y-2">
                <div class="h-64 p-10 flex items-center justify-center bg-white relative">
                  <img src={resimYolu} alt={makineIsmi} class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-110" onerror="this.onerror=null; this.src='/placeholder.png';" />
                </div>
                <div class="p-6 flex flex-col flex-grow">
                  <h3 class="text-xl text-brand-light font-extrabold mb-3 leading-snug">{makineIsmi}</h3>
                  <p class="text-sm text-gray-600 line-clamp-3 mb-6 leading-relaxed">{aciklama}</p>
                  <div class="mt-auto flex justify-end items-center text-sm font-extrabold text-brand-light tracking-wide">
                    DETAYLI BİLGİ <span class="ml-2 text-xl font-normal transition-transform duration-200 group-hover:translate-x-1 group-hover:text-brand-accent">〉</span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="py-20 text-center text-xl font-semibold text-gray-500">Bu kategoriye ait makine bulunamadı. Lütfen Python botunu çalıştırıp verileri güncellediğinizden emin olun.</div>
    )}
    
    <!-- Boş Durum (Filtre sonucu makine kalmazsa) -->
    <div id="empty-state" class="hidden py-20 text-center text-xl font-semibold text-gray-500">Bu alt kategoriye ait makine bulunmamaktadır.</div>
  </section>

  <!-- Dinamik Filtreleme Scripti -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.machine-card');
      const emptyState = document.getElementById('empty-state');

      const applyFilter = (filterValue) => {
        buttons.forEach(b => {
          if (b.getAttribute('data-filter') === filterValue) {
            b.classList.replace('bg-white', 'bg-brand-accent');
            b.classList.replace('text-gray-600', 'text-brand-dark');
            b.classList.replace('border-gray-200', 'border-transparent');
          } else {
            b.classList.replace('bg-brand-accent', 'bg-white');
            b.classList.replace('text-brand-dark', 'text-gray-600');
            b.classList.replace('border-transparent', 'border-gray-200');
          }
        });

        let visibleCount = 0;
        cards.forEach(card => {
          const subcats = card.getAttribute('data-subcategories') || "";
          if (filterValue === 'all' || subcats.includes(filterValue)) {
            (card as HTMLElement).style.display = 'block';
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        if(emptyState) emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      };

      const urlParams = new URLSearchParams(window.location.search);
      const initialFilter = urlParams.get('filter');
      
      let validFilter = 'all';
      if (initialFilter) {
        buttons.forEach(b => { if (b.getAttribute('data-filter') === initialFilter) validFilter = initialFilter; });
      }
      applyFilter(validFilter);

      buttons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const filter = (e.currentTarget as HTMLElement).getAttribute('data-filter');
          const url = new URL(window.location.href);
          if(filter === 'all') url.searchParams.delete('filter');
          else url.searchParams.set('filter', filter);
          window.history.pushState({}, '', url);
          
          applyFilter(filter);
        });
      });
    });
  </script>
</BaseLayout>
