---
import { siteMetadata } from '../data/siteMetadata';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;        // og:image için (opsiyonel, makine resmi vs.)
  canonicalUrl?: string; // override için
}

const {
  title = siteMetadata.title,
  description = siteMetadata.description,
  image = '/og-default.jpg',
  canonicalUrl,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const pageUrl = canonicalUrl || new URL(Astro.url.pathname, siteMetadata.siteUrl).toString();
const ogImage = image.startsWith('http') ? image : new URL(image, siteMetadata.siteUrl).toString();
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'bg' ? 'bg_BG' : lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:site_name" content="Jaguar LTD" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen flex flex-col selection:bg-brand-accent selection:text-white">
    
    <Navbar />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
