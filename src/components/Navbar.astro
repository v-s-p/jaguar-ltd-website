---
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../i18n/utils';
import { sortByOrder, getHeaderSubcategoryOrder } from '../utils/ordering';
const yilmaz = (await import('../data/yilmaz.json')).default;
const gocmaksan = (await import('../data/gocmaksan.json')).default;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (path) => getRelativeLocaleUrl(lang, path);

const uniq = (arr: string[]) => [...new Set(arr.filter(Boolean))];
const aluminiumSubcategories = sortByOrder(
  uniq(yilmaz.filter((m: any) => (m.categories || []).includes('Aluminium')).map((m: any) => m.subcategory)),
  getHeaderSubcategoryOrder('Aluminium'),
  (s) => s
);
const pvcSubcategories = sortByOrder(
  uniq(yilmaz.filter((m: any) => (m.categories || []).includes('PVC')).map((m: any) => m.subcategory)),
  getHeaderSubcategoryOrder('PVC'),
  (s) => s
);
const rebarSubcategories = sortByOrder(
  uniq(gocmaksan.flatMap((m: any) => m.categories || [])),
  getHeaderSubcategoryOrder('Rebar'),
  (s) => s
);

const navSubTranslationKeys: Record<string, string> = {
  // Yılmaz (Aluminium + PVC)
  'Processing Centers': 'cat.sub.centers',
  'Processing Center': 'cat.sub.centers',
  'Saw Cutting': 'cat.sub.sawcutting',
  'Milling': 'cat.sub.milling',
  'Corner Crimping': 'cat.sub.crimping',
  'End Milling': 'cat.sub.endmilling',
  'Transferring': 'cat.sub.transferring',
  'Assembling': 'cat.sub.assembling',
  'Swarf Extraction': 'cat.sub.swarfextract',
  'Cleaning': 'cat.sub.cleaning',
  'Cutting': 'cat.sub.cutting',
  'Screwdriving': 'cat.sub.screwdriving',
  'Welding': 'cat.sub.welding',
  'Conveying': 'cat.sub.conveyor',
  'Pressing': 'cat.sub.press',
  // Göçmaksan (Rebar)
  'Bending Machines': 'cat.sub.bending',
  'Cutting Machines': 'cat.sub.cutting',
  'Combined Machines': 'cat.sub.combined',
  'Steel Factory Solutions': 'cat.sub.factory',
  'Light Construction': 'cat.sub.light',
  'Hand Tools': 'cat.sub.handtools',
};

const navSubLabel = (subcategory: string) =>
  t(navSubTranslationKeys[subcategory] || subcategory);
---
<header class="bg-brand-accent text-white sticky top-0 z-50 shadow-lg border-b-4 border-brand-hover">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="flex justify-between items-center h-24">
      
      <!-- Logo -->
      <div class="flex items-center gap-6">
        <a href={l("/about")} class="flex items-center group" title={t('nav.about')}>
          <img src="/images/logo.png" alt="Jaguar Ltd Logo" class="h-10 md:h-12 w-auto brightness-0 transition-transform group-hover:scale-105"/>
        </a>
      </div>
      
      <!-- Desktop Menü -->
      <nav class="hidden lg:flex space-x-8 items-center font-black text-sm tracking-widest uppercase">
        <a href={l("/")} class="text-slate-900 hover:opacity-70 transition-all border-b-2 border-transparent hover:border-slate-900 pb-1">{t('nav.home')}</a>
        <a href={l("/about")} class="text-slate-900 hover:opacity-70 transition-all border-b-2 border-transparent hover:border-slate-900 pb-1">{t('nav.about')}</a>
        
        <!-- Машини Dropdown -->
        <div class="relative group py-6">
          <button class="text-slate-900 hover:opacity-70 transition-all flex items-center focus:outline-none uppercase font-black pb-1">
            {t('nav.machines')}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div class="absolute left-1/2 -translate-x-1/2 top-full bg-white text-gray-800 w-[700px] shadow-2xl rounded-b-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 border-t-4 border-brand-accent overflow-hidden p-6 flex gap-8">
            
            <!-- Alüminyum -->
            <div class="flex-1">
              <a href={l("/kategori/aluminyum")} class="text-lg font-black text-brand-accent mb-3 block border-b border-gray-100 pb-2 hover:text-brand-hover transition-colors">{t('cat.al')}</a>
              <ul class="space-y-2">
                {aluminiumSubcategories.map((subcategory) => (
                  <li>
                    <a
                      href={l(`/kategori/aluminyum?filter=${encodeURIComponent(subcategory)}`)}
                      class="text-xs font-bold text-gray-500 hover:text-brand-accent hover:pl-1 transition-all block"
                    >
                      {navSubLabel(subcategory)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- PVC -->
            <div class="flex-1">
              <a href={l("/kategori/pvc")} class="text-lg font-black text-brand-accent mb-3 block border-b border-gray-100 pb-2 hover:text-brand-hover transition-colors">{t('cat.pvc')}</a>
              <ul class="space-y-2">
                {pvcSubcategories.map((subcategory) => (
                  <li>
                    <a
                      href={l(`/kategori/pvc?filter=${encodeURIComponent(subcategory)}`)}
                      class="text-xs font-bold text-gray-500 hover:text-brand-accent hover:pl-1 transition-all block"
                    >
                      {navSubLabel(subcategory)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Rebar (Göçmaksan) — dynamic from ordering.json -->
            <div class="flex-1">
              <a href={l("/kategori/rebar")} class="text-lg font-black text-brand-accent mb-3 block border-b border-gray-100 pb-2 hover:text-brand-hover transition-colors">{t('cat.rebar')}</a>
              <ul class="space-y-2">
                {rebarSubcategories.map((subcategory) => (
                  <li>
                    <a
                      href={l(`/kategori/rebar?filter=${encodeURIComponent(subcategory)}`)}
                      class="text-xs font-bold text-gray-500 hover:text-brand-accent hover:pl-1 transition-all block"
                    >
                      {navSubLabel(subcategory)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <a href={l("/gdpr")} class="text-slate-900 hover:opacity-70 transition-all border-b-2 border-transparent hover:border-slate-900 pb-1">{t('nav.cookie')}</a>
        <a href={l("/contact")} class="text-slate-900 hover:opacity-70 transition-all border-b-2 border-transparent hover:border-slate-900 pb-1">{t('nav.contact')}</a>
        
        <LanguagePicker />
      </nav>

      <!-- Hamburger (Mobil) -->
      <button id="mobile-toggle" class="lg:hidden p-2 rounded-lg text-slate-900 hover:bg-brand-hover transition-colors" aria-label="Меню">
        <svg id="hamburger-icon" class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        <svg id="close-icon" class="w-8 h-8 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
  </div>

  <!-- Mobil Menü -->
  <div id="mobile-menu" class="hidden lg:hidden bg-brand-hover border-t border-white/20">
    <div class="container mx-auto px-4 py-6 space-y-4">
      <div class="pb-4 border-b border-white/10 flex justify-between items-center">
        <span class="font-bold text-slate-900/50 text-xs">MENU</span>
        <LanguagePicker />
      </div>
      <a href={l("/")} class="block font-black text-sm text-slate-900 uppercase tracking-widest py-2 border-b border-white/10 hover:opacity-70 transition-all">{t('nav.home')}</a>
      <a href={l("/about")} class="block font-black text-sm text-slate-900 uppercase tracking-widest py-2 border-b border-white/10 hover:opacity-70 transition-all">{t('nav.about')}</a>
      <div class="py-2 border-b border-white/10">
        <span class="block font-black text-sm uppercase tracking-widest text-slate-900/60 mb-2">{t('nav.machines')}</span>
        <a href={l("/kategori/aluminyum")} class="block pl-4 py-1.5 font-bold text-sm text-slate-900 hover:opacity-70 transition-all">› {t('cat.al')}</a>
        <a href={l("/kategori/pvc")} class="block pl-4 py-1.5 font-bold text-sm text-slate-900 hover:opacity-70 transition-all">› {t('cat.pvc')}</a>
        <a href={l("/kategori/rebar")} class="block pl-4 py-1.5 font-bold text-sm text-slate-900 hover:opacity-70 transition-all">› {t('cat.rebar')}</a>
      </div>
      <a href={l("/contact")} class="block font-black text-sm text-slate-900 uppercase tracking-widest py-2 hover:opacity-70 transition-all">{t('nav.contact')}</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    hamburger?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
