---
import { siteMetadata } from '../data/siteMetadata';
---

<header class="bg-brand-dark text-white sticky top-0 z-50 shadow-md">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="flex justify-between items-center h-20">
      
      <!-- Logo -->
      <a href="/" class="text-2xl font-extrabold tracking-wider text-brand-accent flex items-center gap-2 transition-transform hover:scale-105">
        <span class="bg-brand-accent text-brand-dark px-2 py-1 rounded text-xl">J</span>AGUAR LTD
      </a>
      
      <!-- Menü -->
      <nav class="hidden md:flex space-x-8 items-center font-bold text-sm tracking-wide">
        <a href="/" class="hover:text-brand-accent transition-colors">ANA SAYFA</a>
        
        <!-- Kategoriler Dropdown -->
        <div class="relative group py-6">
          <button class="hover:text-brand-accent transition-colors flex items-center focus:outline-none">
            MAKİNELERİMİZ
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <!-- Mega Menü İçeriği -->
          <div class="absolute top-full left-1/2 -translate-x-1/2 w-[700px] bg-white text-gray-800 shadow-2xl rounded-b-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 border-t-4 border-brand-accent overflow-hidden transform origin-top group-hover:scale-y-100 scale-y-0 flex p-8 gap-12 cursor-default">
            
            <!-- Alüminyum Sütunu -->
            <div class="flex-1">
              <a href="/kategori/aluminyum" class="text-xl font-extrabold text-brand-dark mb-4 block border-b-2 border-gray-100 pb-2 hover:text-brand-accent transition-colors">ALÜMİNYUM</a>
              <ul class="space-y-2.5">
                <li><a href="/kategori/aluminyum?filter=İŞLEME MERKEZLERİ" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">İşleme Merkezleri</a></li>
                <li><a href="/kategori/aluminyum?filter=KESİM" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Kesim</a></li>
                <li><a href="/kategori/aluminyum?filter=FREZE" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Freze</a></li>
                <li><a href="/kategori/aluminyum?filter=KÖŞE PRES" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Köşe Pres</a></li>
                <li><a href="/kategori/aluminyum?filter=KERTME" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Kertme</a></li>
                <li><a href="/kategori/aluminyum?filter=PRES" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Pres</a></li>
                <li><a href="/kategori/aluminyum?filter=TAŞIMA" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Taşıma</a></li>
                <li><a href="/kategori/aluminyum?filter=AKTARMA" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Aktarma</a></li>
                <li><a href="/kategori/aluminyum?filter=TALAŞ TOPLAMA" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Talaş Toplama</a></li>
                <li><a href="/kategori/aluminyum?filter=MONTAJ" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Montaj</a></li>
              </ul>
            </div>

            <!-- PVC Sütunu -->
            <div class="flex-1">
              <a href="/kategori/pvc" class="text-xl font-extrabold text-brand-dark mb-4 block border-b-2 border-gray-100 pb-2 hover:text-brand-accent transition-colors">PVC</a>
              <ul class="space-y-2.5">
                <li><a href="/kategori/pvc?filter=İŞLEME MERKEZİ" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">İşleme Merkezi</a></li>
                <li><a href="/kategori/pvc?filter=ÇAPAK ALMA" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Çapak Alma</a></li>
                <li><a href="/kategori/pvc?filter=KESİM" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Kesim</a></li>
                <li><a href="/kategori/pvc?filter=FREZE" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Freze</a></li>
                <li><a href="/kategori/pvc?filter=KERTME" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Kertme</a></li>
                <li><a href="/kategori/pvc?filter=VİDALAMA" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Vidalama</a></li>
                <li><a href="/kategori/pvc?filter=KAYNAK" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Kaynak</a></li>
                <li><a href="/kategori/pvc?filter=TAŞIMA" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Taşıma</a></li>
                <li><a href="/kategori/pvc?filter=TALAŞ TOPLAMA" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Talaş Toplama</a></li>
                <li><a href="/kategori/pvc?filter=AKTARMA" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Aktarma</a></li>
                <li><a href="/kategori/pvc?filter=MONTAJ" class="text-sm font-semibold text-gray-600 hover:text-brand-accent hover:pl-2 transition-all block">Montaj</a></li>
              </ul>
            </div>
            
          </div>
        </div>
      </nav>

      <!-- İletişim Butonu -->
      <div class="hidden md:block">
        <a href="mailto:info@jaguar-ltd.com" class="bg-brand-accent text-brand-dark px-6 py-2.5 rounded-full font-extrabold hover:bg-white transition-colors shadow-sm">Bize Ulaşın</a>
      </div>
    </div>
  </div>
</header>