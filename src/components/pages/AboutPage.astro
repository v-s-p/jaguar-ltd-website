---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`${t('nav.about')} | Jaguar LTD`}>
  <section class="container mx-auto px-4 py-16 max-w-4xl">
    <div class="mb-10">
      <h1 class="text-4xl font-black text-gray-900 tracking-tight uppercase">{t('nav.about')}</h1>
      <p class="text-gray-400 font-bold text-sm mt-1 uppercase tracking-widest">{t('about.since')}</p>
    </div>
    
    <div class="prose prose-lg max-w-none text-gray-600 leading-relaxed space-y-6">
      <p class="font-black text-xl text-gray-900">
        {t('about.p1')}
      </p>
      
      <p>
        {t('about.p2')}
      </p>

      <div class="bg-brand-warm p-8 rounded-2xl border-l-8 border-brand-accent my-8">
        <p class="italic font-bold text-gray-700">
          {t('about.quote')}
        </p>
      </div>

      <p>
        {t('about.p3')}
      </p>

      <p>
        {t('about.p4')}
      </p>

      <!-- Partner Logolar -->
      <div class="flex flex-wrap items-center gap-12 mt-12 pt-8 border-t border-gray-200">
        <div class="text-center">
          <img src="/images/yilmaz_logo.svg" alt="Yılmaz Machine" class="h-10 w-auto mb-2" onerror="this.style.display='none'" />
          <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">{t('hero.partner')} {t('hero.partner.since')}</p>
        </div>
        <div class="text-center">
          <img src="/images/gocmaksan_logo.svg" alt="Göçmaksan" class="h-10 w-auto mb-2" onerror="this.style.display='none'" />
          <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">{t('hero.distributor')} {t('hero.distributor.since')}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
