---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoModal from '../VideoModal.astro';
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../../i18n/utils';
import { marked } from 'marked';
marked.use({ breaks: true, gfm: true });

export async function getStaticPaths() {
  // getStaticPaths izole scope'da calisiyor - import'lar burada olmali
  const yilmazMachines = (await import('../../data/yilmaz.json')).default;
  const gocmaksanMachines = (await import('../../data/gocmaksan.json')).default;
  const allMachines = [...yilmazMachines, ...gocmaksanMachines];

  return allMachines.map((machine: any) => ({
    params: { slug: machine.slug },
    props: { machine },
  }));
}

const { machine } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (path: string) => getRelativeLocaleUrl(lang, path);
const backUrl = machine.brand === 'gocmaksan'
  ? l('/kategori/gocmaksan')
  : machine.categories?.includes('Aluminium')
    ? l('/kategori/aluminyum')
    : l('/kategori/pvc');

const activeLang = machine.diller?.[lang] || {};
const enLang     = machine.diller?.en     || {};

const isim        = activeLang.name        || activeLang.isim        || enLang.name    || enLang.isim    || machine.slug;
const aciklama    = activeLang.description || activeLang.aciklama    || enLang.description || enLang.aciklama || '';
const descriptionHtml = aciklama ? String(marked.parse(aciklama)) : '';
const seoDescription  = aciklama
  .replace(/^#+\s+/gm, '')
  .replace(/\*\*(.+?)\*\*/g, '$1')
  .replace(/\n+/g, ' ')
  .trim()
  .slice(0, 160);
const resimler    = activeLang.images      || activeLang.resimler    || enLang.images  || enLang.resimler || [];
const anaResim    = resimler.length > 0 ? resimler[0] : '/placeholder.png';
const galeri      = resimler.length > 1 ? resimler.slice(1) : [];

const ozellikGruplari = activeLang.specs || enLang.specs || (machine as any).specs || activeLang.ozellik_gruplari || {};
const renderableSpecCount = Object.entries(ozellikGruplari)
  .filter(([, v]: [string, any]) => Array.isArray(v) && v.length > 0)
  .length;
const specGridClass = renderableSpecCount === 1 ? 'grid-cols-1'
                    : renderableSpecCount === 2 ? 'grid-cols-1 md:grid-cols-2'
                    : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3';
const teknikTablo     = activeLang.technical_data || enLang.technical_data || {};
const piktogramlar    = activeLang.piktogramlar      || activeLang.specifications || {};
const katalog         = activeLang.catalog || activeLang.katalog || activeLang.pdf_catalog || enLang.catalog || enLang.katalog || enLang.pdf_catalog || (machine as any).pdf_catalog || null;
const video           = activeLang.video   || enLang.video   || null;

// Keys are now snake_case after normalization; t() resolves to correct locale label.
// EN labels restore the display-caps form; BG/RU return Cyrillic translations.
const specLabels: Record<string, string> = {
  general_features:    t('spec.general_features' as any),
  capacities:          t('spec.capacities' as any),
  supplied_equipment:  t('spec.supplied_equipment' as any),
  standard_accessories: t('spec.standard_accessories' as any),
  optional_accessories: t('spec.optional_accessories' as any),
};
---

<BaseLayout
  title={`${isim} | Jaguar LTD`}
  description={seoDescription || `${isim} - Jaguar LTD`}
  image={anaResim}
>
  <div class="bg-gray-50 py-12 min-h-screen">
    <div class="container mx-auto px-4 max-w-7xl">

      <!-- Geri Don -->
      <div class="mb-8">
        <a href={backUrl} class="text-brand-light hover:text-brand-accent font-bold transition-colors flex items-center">
          <span class="mr-2 text-xl">&larr;</span> {t('nav.machines')}
        </a>
      </div>

      <!-- Ana Kart -->
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
        <div class="grid grid-cols-1 lg:grid-cols-2">

          <!-- Gorsel -->
          <div class="p-12 flex items-center justify-center bg-white border-b lg:border-b-0 lg:border-r border-gray-100">
            <img
              src={anaResim}
              alt={isim}
              class="w-full h-auto max-h-[500px] object-contain hover:scale-105 transition-transform duration-500"
              onerror="this.onerror=null; this.src='/placeholder.png';"
            />
          </div>

          <!-- Aciklama -->
          <div class="p-10 lg:p-14 flex flex-col justify-start bg-gray-50">
            <h1 class="text-3xl lg:text-4xl font-extrabold text-gray-900 mb-4 tracking-tight leading-tight">{isim}</h1>
            {aciklama && (
              <div class="machine-description text-base text-gray-600 leading-relaxed mb-8"
                   set:html={descriptionHtml} />
            )}

            {Object.keys(piktogramlar).length > 0 && (
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                {Object.entries(piktogramlar).map(([key, val]) => (
                  <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
                    <span class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">
                      {key.replace(/_/g, ' ')}
                    </span>
                    <span class="block text-sm font-semibold text-gray-800">{val}</span>
                  </div>
                ))}
              </div>
            )}

            {(katalog || video) && (
              <div class="mt-8 flex flex-wrap gap-3">
                {katalog && (
                  <a
                    href={katalog}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center px-6 py-3 text-base font-bold rounded-xl shadow-sm text-white transition-all duration-300"
                    style={`background:${machine.brand === 'gocmaksan' ? '#E8751A' : '#00A8B5'}`}
                  >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    {t('machine.catalog')}
                  </a>
                )}
                {video && (
                  <button
                    type="button"
                    class="inline-flex items-center px-6 py-3 text-base font-bold rounded-xl shadow-sm text-white transition-all duration-300"
                    style={`background:${machine.brand === 'gocmaksan' ? '#E8751A' : '#00A8B5'}`}
                    onclick="document.getElementById('video-section')?.scrollIntoView({behavior:'smooth',block:'center'})"
                  >
                    <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                    {t('machine.video_btn' as any)}
                  </button>
                )}
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Teknik Veri Tablosu -->
      {Object.keys(teknikTablo).length > 0 && (
        <div class="mt-12 bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
          <h3 class="text-2xl font-extrabold text-gray-900 mb-6">
            {t('machine.technical_data') || 'Technical Data'}
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            {Object.entries(teknikTablo).map(([key, val]) => (
              <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-center hover:border-[#00A8B5] transition-colors duration-200">
                <div class="text-lg font-extrabold text-gray-900">{String(val)}</div>
                <div class="text-xs text-gray-400 font-bold uppercase tracking-wider mt-1">
                  {key.replace(/_/g, ' ')}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Ozellik Gruplari -->
      {renderableSpecCount > 0 && (
        <div class={`mt-12 grid gap-8 ${specGridClass}`}>
          {Object.entries(ozellikGruplari).map(([baslik, maddeler]: [string, any]) => (
            maddeler && maddeler.length > 0 && (
              <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-200 hover:border-[#00A8B5] transition-colors duration-300">
                <h3 class="text-xl font-extrabold text-gray-900 mb-6 border-b border-gray-100 pb-3">{specLabels[baslik] || baslik}</h3>
                <ul class="space-y-3">
                  {maddeler.map((madde: string) => (
                    <li class="flex items-start text-gray-700">
                      <span class="mr-3 mt-1 font-bold text-lg leading-none" style="color:#00A8B5">✓</span>
                      <span class="text-sm leading-relaxed">{madde}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          ))}
        </div>
      )}

      <!-- Galeri + Video -->
      {(video || galeri.length > 0) && (
        <div class="mt-12 bg-white p-8 lg:p-12 rounded-2xl shadow-sm border border-gray-100">
          <h3 class="text-2xl font-extrabold text-gray-900 mb-8">{t('machine.media')}</h3>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
            {video && (
              <div class="flex flex-col">
                <span class="text-sm font-bold text-gray-500 mb-3 uppercase tracking-wider">{t('machine.video')}</span>
                <VideoModal videoUrl={video} machineTitle={isim} />
              </div>
            )}
            {galeri.length > 0 && (
              <div class={`flex flex-col ${!video ? 'lg:col-span-2' : ''}`}>
                <span class="text-sm font-bold text-gray-500 mb-3 uppercase tracking-wider">{t('machine.gallery')}</span>
                <div class={`grid gap-4 ${!video ? 'grid-cols-2 sm:grid-cols-4 lg:grid-cols-5' : 'grid-cols-2 sm:grid-cols-3'}`}>
                  {galeri.map((resim: string) => (
                    <a href={resim} target="_blank" rel="noopener noreferrer"
                       class="block aspect-square overflow-hidden rounded-xl border border-gray-200 hover:border-[#00A8B5] hover:shadow-md transition-all bg-white p-2">
                      <img src={resim} alt={isim} class="w-full h-full object-contain hover:scale-110 transition-transform duration-500" loading="lazy" />
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      )}

    </div>
  </div>
</BaseLayout>

<style>
  .machine-description :global(h2) {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 1.25rem 0 0.4rem;
    color: #1f2937;
  }
  .machine-description :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    margin: 1rem 0 0.3rem;
    color: #374151;
  }
  .machine-description :global(p) {
    margin-bottom: 0.75rem;
    line-height: 1.65;
  }
  .machine-description :global(ul),
  .machine-description :global(ol) {
    margin: 0.4rem 0 0.75rem 1.25rem;
  }
  .machine-description :global(li) {
    margin-bottom: 0.2rem;
  }
  .machine-description :global(strong) {
    font-weight: 600;
  }
</style>
