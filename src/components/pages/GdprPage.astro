---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../../i18n/utils';
import gdprData from '../../data/pages/gdpr.json';

const lang = getLangFromUrl(Astro.url);

const title = lang === 'ru' ? gdprData.title_ru
  : lang === 'en' ? gdprData.title_en
  : gdprData.title_bg;

const body = lang === 'ru' ? gdprData.body_ru
  : lang === 'en' ? gdprData.body_en
  : gdprData.body_bg;

function mdToHtml(md: string): string {
  const lines = md.split('\n');
  const out: string[] = [];
  let inList = false;

  const inline = (s: string) =>
    s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
     .replace(/\*([^*\n]+)\*/g, '<em>$1</em>');

  for (const raw of lines) {
    const l = inline(raw);
    if (l.startsWith('## ')) {
      if (inList) { out.push('</ul>'); inList = false; }
      out.push(`<h2 class="text-xl font-black text-gray-900 mt-8 mb-3">${l.slice(3)}</h2>`);
    } else if (l.startsWith('> ')) {
      if (inList) { out.push('</ul>'); inList = false; }
      out.push(`<blockquote class="border-l-4 border-brand-accent pl-4 italic text-gray-700 my-4">${l.slice(2)}</blockquote>`);
    } else if (l.startsWith('- ')) {
      if (!inList) { out.push('<ul class="list-disc ml-5 space-y-2 my-3">'); inList = true; }
      out.push(`<li>${l.slice(2)}</li>`);
    } else if (l === '---') {
      if (inList) { out.push('</ul>'); inList = false; }
      out.push('<hr class="my-6 border-gray-200">');
    } else if (l.trim() === '') {
      if (inList) { out.push('</ul>'); inList = false; }
    } else {
      if (inList) { out.push('</ul>'); inList = false; }
      out.push(`<p class="text-gray-600 mb-3">${l}</p>`);
    }
  }
  if (inList) out.push('</ul>');
  return out.join('\n');
}
---

<BaseLayout title={`${title} | Jaguar LTD`}>
  <section class="container mx-auto px-4 py-16 max-w-4xl">
    <div class="mb-10">
      <h1 class="text-3xl font-black text-gray-900 tracking-tight uppercase">{title}</h1>
      <p class="text-gray-400 font-bold text-sm mt-1 uppercase tracking-widest">Cookie &amp; Privacy Policy</p>
    </div>

    <div class="prose max-w-none text-gray-600 space-y-2">
      <Fragment set:html={mdToHtml(body)} />
    </div>
  </section>
</BaseLayout>
