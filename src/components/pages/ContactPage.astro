---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../../i18n/utils';
import { siteMetadata } from '../../data/siteMetadata';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (path) => getRelativeLocaleUrl(lang, path);
---

<BaseLayout title="Контакти | Jaguar LTD">
  <section class="container mx-auto px-4 py-16 max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      
      <!-- İletişim Bilgileri -->
      <div>
        <h1 class="text-4xl font-black text-brand-accent uppercase mb-2">{t('contact.title')}</h1>
        <p class="text-gray-400 mb-10 text-sm font-bold uppercase tracking-widest">{t('contact.subtitle')}</p>
        
        <div class="space-y-8">
          <div class="flex items-center gap-5">
            <div class="bg-brand-accent p-4 rounded-2xl text-white shadow-md flex-shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">{t('contact.form.phone')}</p>
              <a href="tel:+359887973739" class="text-xl text-gray-800 font-black hover:text-brand-accent transition-colors">+359 (887) 973 739</a>
            </div>
          </div>

          <div class="flex items-center gap-5">
            <div class="bg-brand-accent p-4 rounded-2xl text-white shadow-md flex-shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">{t('contact.form.email')}</p>
              <a href={`mailto:${siteMetadata.contact.email}`} class="text-xl text-gray-800 font-black hover:text-brand-accent transition-colors">{siteMetadata.contact.email}</a>
            </div>
          </div>

          <div class="flex items-center gap-5">
            <div class="bg-brand-accent p-4 rounded-2xl text-white shadow-md flex-shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">{t('nav.contact')}</p>
              <p class="text-sm text-gray-700 font-bold">{t('contact.address')}</p>
              <p class="text-xs text-gray-400 font-bold">{t('contact.warehouse')}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="bg-gray-50 p-8 rounded-3xl border border-gray-200 shadow-sm">
        <h2 class="text-lg font-black text-gray-900 uppercase tracking-wider mb-6">{t('contact.form.send')}</h2>
        <div class="space-y-4">
          <div>
            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">{t('contact.form.name')}</label>
            <input type="text" placeholder="" class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm font-bold focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 outline-none transition-all" />
          </div>
          <div>
            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">{t('contact.form.email')}</label>
            <input type="email" placeholder="email@example.com" class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm font-bold focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 outline-none transition-all" />
          </div>
          <div>
            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">{t('contact.form.phone')}</label>
            <input type="tel" placeholder="+359 ..." class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm font-bold focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 outline-none transition-all" />
          </div>
          <div>
            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">{t('contact.form.message')}</label>
            <textarea rows="4" placeholder="" class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm font-bold focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 outline-none transition-all resize-none"></textarea>
          </div>
          <div class="flex items-start gap-2 mt-2">
            <input type="checkbox" id="gdpr-consent" class="mt-1 accent-brand-accent" />
            <label for="gdpr-consent" class="text-[10px] text-gray-400 font-bold leading-relaxed">
              {t('contact.form.gdpr')} <a href={l("/gdpr")} class="text-brand-accent hover:underline">{t('nav.cookie')}</a>
            </label>
          </div>
          <button class="w-full bg-brand-accent text-white font-black py-4 rounded-2xl hover:bg-brand-hover transition-all uppercase tracking-widest text-sm mt-2">{t('contact.form.send')}</button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
