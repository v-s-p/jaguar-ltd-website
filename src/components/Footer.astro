---
import { siteMetadata } from '../data/siteMetadata';
---

<footer class="bg-brand-light text-gray-300 pt-16 pb-8 border-t-4 border-brand-accent mt-auto">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      
      <!-- Kurumsal Bilgi -->
      <div>
        <a href="/" class="text-3xl font-extrabold tracking-wider text-white mb-6 block">
          <span class="text-brand-accent">JAGUAR</span> LTD
        </a>
        <p class="text-sm leading-relaxed mb-6 text-gray-400">
          {siteMetadata.description}
        </p>
      </div>

      <!-- Alüminyum Linkler -->
      <div>
        <h4 class="text-lg font-bold text-white mb-6 border-b border-gray-700 pb-2 inline-block">Alüminyum</h4>
        <ul class="space-y-3 text-sm font-semibold">
          <li><a href="/kategori/aluminyum?filter=İŞLEME MERKEZLERİ" class="hover:text-brand-accent transition-colors flex items-center"><span class="text-brand-accent mr-2">›</span> İşleme Merkezleri</a></li>
          <li><a href="/kategori/aluminyum?filter=KESİM" class="hover:text-brand-accent transition-colors flex items-center"><span class="text-brand-accent mr-2">›</span> Kesim Makineleri</a></li>
          <li><a href="/kategori/aluminyum?filter=FREZE" class="hover:text-brand-accent transition-colors flex items-center"><span class="text-brand-accent mr-2">›</span> Frezeler</a></li>
          <li><a href="/kategori/aluminyum" class="hover:text-brand-accent transition-colors flex items-center"><span class="text-brand-accent mr-2">›</span> Tümünü Gör</a></li>
        </ul>
      </div>

      <!-- PVC Linkler -->
      <div>
        <h4 class="text-lg font-bold text-white mb-6 border-b border-gray-700 pb-2 inline-block">PVC</h4>
        <ul class="space-y-3 text-sm font-semibold">
          <li><a href="/kategori/pvc?filter=KAYNAK" class="hover:text-brand-accent transition-colors flex items-center"><span class="text-brand-accent mr-2">›</span> Kaynak Makineleri</a></li>
          <li><a href="/kategori/pvc?filter=ÇAPAK ALMA" class="hover:text-brand-accent transition-colors flex items-center"><span class="text-brand-accent mr-2">›</span> Çapak Alma</a></li>
          <li><a href="/kategori/pvc?filter=KESİM" class="hover:text-brand-accent transition-colors flex items-center"><span class="text-brand-accent mr-2">›</span> Kesim Makineleri</a></li>
          <li><a href="/kategori/pvc" class="hover:text-brand-accent transition-colors flex items-center"><span class="text-brand-accent mr-2">›</span> Tümünü Gör</a></li>
        </ul>
      </div>

      <!-- İletişim -->
      <div>
        <h4 class="text-lg font-bold text-white mb-6 border-b border-gray-700 pb-2 inline-block">İletişim</h4>
        <ul class="space-y-4 text-sm font-semibold">
          <li class="flex items-center"><span class="text-brand-accent text-xl mr-3">✉</span> <a href={`mailto:${siteMetadata.contact.email}`} class="hover:text-brand-accent transition-colors">{siteMetadata.contact.email}</a></li>
          <li class="flex items-center"><span class="text-brand-accent text-xl mr-3">📞</span> <a href={`tel:${siteMetadata.contact.phone.replace(/\s+/g, '')}`} class="hover:text-brand-accent transition-colors">{siteMetadata.contact.phone}</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-gray-500 font-semibold">
      <p>&copy; {new Date().getFullYear()} Jaguar LTD. Tüm hakları saklıdır.</p>
    </div>
  </div>
</footer>