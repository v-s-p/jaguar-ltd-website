---
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (path) => getRelativeLocaleUrl(lang, path);
---
<footer class="bg-gray-900 text-gray-300 pt-16 pb-8 border-t-8 border-brand-accent mt-auto">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      
      <div>
        <a href={l("/about")} class="inline-block mb-6 group">
          <img src="/images/logo.png" alt="Jaguar Ltd" class="h-10 w-auto brightness-0 invert group-hover:scale-105 transition-transform"/>
        </a>
        <div class="flex flex-col gap-5">
          <a href={l("/kategori/pvc")} class="group flex items-center gap-3">
            <img src="/images/yilmaz_logo.svg" alt="Yılmaz Machine" class="h-6 w-auto brightness-0 invert opacity-60 group-hover:opacity-100 transition-opacity" />
            <span class="text-[10px] leading-tight text-gray-500 font-bold uppercase tracking-wider group-hover:text-gray-300 transition-colors">{t('hero.partner')}<br/>{t('hero.partner.since')}</span>
          </a>
          <a href={l("/kategori/gocmaksan")} class="group flex items-center gap-3">
            <img src="/images/gocmaksan_logo.svg" alt="Göçmaksan" class="h-5 w-auto brightness-0 invert opacity-60 group-hover:opacity-100 transition-opacity" />
            <span class="text-[10px] leading-tight text-gray-500 font-bold uppercase tracking-wider group-hover:text-gray-300 transition-colors">{t('hero.distributor')}<br/>{t('hero.distributor.since')}</span>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-brand-accent font-black mb-6 uppercase tracking-widest text-sm">{t('footer.menu')}</h4>
        <ul class="space-y-3 text-sm font-bold">
          <li><a href={l("/")} class="hover:text-white transition-colors">› {t('nav.home')}</a></li>
          <li><a href={l("/about")} class="hover:text-white transition-colors">› {t('nav.about')}</a></li>
          <li><a href={l("/contact")} class="hover:text-white transition-colors">› {t('nav.contact')}</a></li>
          <li><a href={l("/gdpr")} class="hover:text-white transition-colors">› {t('nav.cookie')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-brand-accent font-black mb-6 uppercase tracking-widest text-sm">{t('nav.machines')}</h4>
        <ul class="space-y-3 text-sm font-bold">
          <li><a href={l("/kategori/aluminyum")} class="hover:text-white transition-colors">› {t('cat.al')}</a></li>
          <li><a href={l("/kategori/pvc")} class="hover:text-white transition-colors">› {t('cat.pvc')}</a></li>
          <li><a href={l("/kategori/gocmaksan")} class="hover:text-white transition-colors">› {t('cat.rebar')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-brand-accent font-black mb-6 uppercase tracking-widest text-sm">{t('nav.contact')}</h4>
        <ul class="space-y-4 text-sm font-bold">
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-brand-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:jaguar@jaguar-ltd.com" class="hover:text-white transition-colors">jaguar@jaguar-ltd.com</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-brand-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <a href="tel:+359887973739" class="hover:text-white transition-colors">+359 (887) 973 739</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8 pb-4 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-[10px] text-gray-600 font-black tracking-[0.3em] uppercase">
        &copy; {new Date().getFullYear()} JAGUAR LTD. {t('footer.rights')}
      </div>
      <div>
        <LanguagePicker />
      </div>
    </div>
  </div>
</footer>
